# ─────────────────────────────────────────────────────────────
# PRODUCTION .env for shared hosting (cPanel / PHP & WordPress host)
# Copy this to ".env" on the server (in the pantheraa/ folder) and fill in
# the values marked CHANGE-ME. Keep APP_KEY exactly as-is.
# ─────────────────────────────────────────────────────────────

APP_NAME="Pantheraa Space"
APP_ENV=production
# Generate with: php artisan key:generate  (or copy your existing key)
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE-ME-your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Database: create this in cPanel → MySQL Databases, then fill in ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE-ME_dbname
DB_USERNAME=CHANGE-ME_dbuser
DB_PASSWORD=CHANGE-ME_dbpass

# DB-backed (no Redis needed on shared hosting)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Email: leads always save to the DB. To ALSO email them, set SMTP ──
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.your-host.com
# MAIL_PORT=587
# MAIL_USERNAME=you@your-domain.com
# MAIL_PASSWORD=CHANGE-ME
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@CHANGE-ME-your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
